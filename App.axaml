<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LMTodo.Converters"
    x:Class="LMTodo.App">

    <Application.Resources>

        <!-- ================================================= -->
        <!-- 基础色板                                          -->
        <!-- 主色 #ACE2F1 · 辅色 #FFCCD5                       -->
        <!-- 其余颜色都是这两个色相的明度 / 饱和度变体          -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="PrimaryBrush" Color="#ACE2F1" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#63B8D2" />
        <SolidColorBrush x:Key="PrimaryDeepBrush" Color="#2E6B80" />

        <SolidColorBrush x:Key="AccentBrush" Color="#FFCCD5" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#E99AAA" />
        <SolidColorBrush x:Key="AccentDeepBrush" Color="#B86A7A" />

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F7FBFD" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DDECF1" />
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#E9F2F5" />

        <SolidColorBrush x:Key="TextBrush" Color="#344454" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7B8995" />
        <SolidColorBrush x:Key="FaintTextBrush" Color="#9AA6AF" />

        <SolidColorBrush x:Key="SoftBlueBrush" Color="#EDF9FC" />
        <SolidColorBrush x:Key="SofterBlueBrush" Color="#F4FBFD" />
        <SolidColorBrush x:Key="SoftPinkBrush" Color="#FFF1F4" />
        <SolidColorBrush x:Key="SoftGreenBrush" Color="#ECFAF4" />

        <SolidColorBrush x:Key="DangerBrush" Color="#E0506E" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFF4F6" />

        <LinearGradientBrush
            x:Key="PrimaryGradient"
            StartPoint="0,0"
            EndPoint="1,1">
            <GradientStop Offset="0" Color="#ACE2F1" />
            <GradientStop Offset="1" Color="#8DD2E7" />
        </LinearGradientBrush>

        <LinearGradientBrush
            x:Key="AccentGradient"
            StartPoint="0,0"
            EndPoint="1,1">
            <GradientStop Offset="0" Color="#ACE2F1" />
            <GradientStop Offset="1" Color="#FFCCD5" />
        </LinearGradientBrush>

        <!-- ================================================= -->
        <!-- 转换器                                            -->
        <!-- ================================================= -->

        <local:DueDateBrushConverter x:Key="DueDateBrushConverter" />
        <local:EnumLabelConverter x:Key="EnumLabelConverter" />
        <local:FilterLabelConverter x:Key="FilterLabelConverter" />
        <local:CountToBoolConverter x:Key="CountToBoolConverter" />
        <local:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        <local:PriorityBrushConverter x:Key="PriorityBrushConverter" />
        <local:HexToBrushConverter x:Key="HexToBrushConverter" />
        <local:HabitBrushConverter x:Key="HabitBrushConverter" />

        <!-- ================================================= -->
        <!-- 枚举下拉框统一模板                                 -->
        <!-- x:CompileBindings="False" 让 {Binding} 拿到枚举值本身 -->
        <!-- ================================================= -->

        <DataTemplate x:Key="EnumOptionTemplate">
            <TextBlock
                Text="{Binding Converter={StaticResource EnumLabelConverter}}"
                FontSize="12" />
        </DataTemplate>

        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock
                Text="{Binding Converter={StaticResource FilterLabelConverter}}"
                FontSize="12" />
        </DataTemplate>

    </Application.Resources>


    <Application.Styles>

        <FluentTheme />

        <!-- ================================================= -->
        <!-- 窗口默认字体                                       -->
        <!-- ================================================= -->

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Inter, Segoe UI" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!-- ================================================= -->
        <!-- 导航                                              -->
        <!-- ================================================= -->

        <Style Selector="ToggleButton.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#647987" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style Selector="ToggleButton.nav:pointerover">
            <Setter Property="Background" Value="#EDF9FC" />
            <Setter Property="Foreground" Value="#4E9DB8" />
        </Style>

        <Style Selector="ToggleButton.nav:checked">
            <Setter Property="Background" Value="#DFF5FA" />
            <Setter Property="Foreground" Value="#2E6B80" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ================================================= -->
        <!-- 按钮                                              -->
        <!-- ================================================= -->

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
            <Setter Property="Foreground" Value="#243C48" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        </Style>

        <Style Selector="Button.soft">
            <Setter Property="Background" Value="#FFF1F4" />
            <Setter Property="Foreground" Value="#B86A7A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.soft:pointerover">
            <Setter Property="Background" Value="#FFE3E9" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#526371" />
            <Setter Property="BorderBrush" Value="#D8E8EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftPinkBrush}" />
            <Setter Property="BorderBrush" Value="#F2C7D0" />
            <Setter Property="Foreground" Value="#A96878" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8A98A3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftPinkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
        </Style>

        <Style Selector="Button.tiny">
            <Setter Property="Background" Value="#F2FAFC" />
            <Setter Property="Foreground" Value="#4E8FA6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Button.tiny:pointerover">
            <Setter Property="Background" Value="#DFF4FA" />
        </Style>

        <!-- ================================================= -->
        <!-- 卡片                                              -->
        <!-- ================================================= -->

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- 逾期标红：任务卡整体换边框和底色，一眼能扫出来 -->
        <Style Selector="Border.card.overdue">
            <Setter Property="Background" Value="#FFFAFB" />
            <Setter Property="BorderBrush" Value="#F6C3CE" />
        </Style>

        <!-- 悬停：提示这张卡是可以点的 -->
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="#B9E4EF" />
        </Style>

        <!--
            选中：说明右侧详情面板正在编辑这一条。
            刻意只换色调、不加粗描边 —— 改 BorderThickness 会让卡片内容抖一下。
        -->
        <Style Selector="Border.card.selected">
            <Setter Property="Background" Value="#E8F6FC" />
            <Setter Property="BorderBrush" Value="#7FC7DE" />
        </Style>

        <Style Selector="Border.board-column">
            <Setter Property="Background" Value="#F8FCFD" />
            <Setter Property="BorderBrush" Value="#DDECF1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style Selector="Border.board-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E4EFF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>

        <Style Selector="Border.board-card:pointerover">
            <Setter Property="BorderBrush" Value="#B9E4EF" />
            <Setter Property="Background" Value="#FCFEFF" />
        </Style>

        <Style Selector="Border.board-card.selected">
            <Setter Property="Background" Value="#E8F6FC" />
            <Setter Property="BorderBrush" Value="#7FC7DE" />
        </Style>

        <!-- ================================================= -->
        <!-- 任务勾选框                                        -->
        <!-- ================================================= -->

        <Style Selector="ToggleButton.task-check">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C7E5EF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="ToggleButton.task-check:pointerover">
            <Setter Property="Background" Value="#EDF9FC" />
            <Setter Property="BorderBrush" Value="#8DD2E7" />
        </Style>

        <Style Selector="ToggleButton.task-check:checked">
            <Setter Property="Background" Value="#ACE2F1" />
            <Setter Property="BorderBrush" Value="#7FC7DE" />
        </Style>

        <Style Selector="ToggleButton.task-check TextBlock">
            <Setter Property="Foreground" Value="#B4D8E4" />
        </Style>

        <Style Selector="ToggleButton.task-check:checked TextBlock">
            <Setter Property="Foreground" Value="#24606F" />
        </Style>

        <!-- ================================================= -->
        <!-- 标签 / 徽章                                       -->
        <!-- ================================================= -->

        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#F3FAFC" />
            <Setter Property="BorderBrush" Value="#E1EFF4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="7,2" />
        </Style>

        <Style Selector="Border.chip.pink">
            <Setter Property="Background" Value="#FFF4F6" />
            <Setter Property="BorderBrush" Value="#FAD9E0" />
        </Style>

        <Style Selector="Border.chip.danger">
            <Setter Property="Background" Value="#FFEDF1" />
            <Setter Property="BorderBrush" Value="#F6C3CE" />
        </Style>

        <Style Selector="Border.chip.done">
            <Setter Property="Background" Value="#EFFAF5" />
            <Setter Property="BorderBrush" Value="#CDEBDF" />
        </Style>

        <!-- ================================================= -->
        <!-- 月历格                                            -->
        <!-- ================================================= -->

        <Style Selector="Border.cal-cell">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EDF4F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style Selector="Border.cal-cell.padding-day">
            <Setter Property="Background" Value="#FBFDFE" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="Border.cal-cell:pointerover">
            <Setter Property="Background" Value="#F4FBFD" />
            <Setter Property="BorderBrush" Value="#BFE5F0" />
        </Style>

        <Style Selector="Border.cal-cell.selected">
            <Setter Property="Background" Value="#EDF9FC" />
            <Setter Property="BorderBrush" Value="#8DD2E7" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- ================================================= -->
        <!-- 输入框                                            -->
        <!-- ================================================= -->

        <Style Selector="TextBox.editor">
            <Setter Property="Background" Value="#FAFCFD" />
            <Setter Property="BorderBrush" Value="#D8E9EF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBox.editor:focus">
            <Setter Property="BorderBrush" Value="#8DD2E7" />
        </Style>

        <Style Selector="TextBox.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="CalendarDatePicker">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="TimePicker">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Background" Value="#EAF6F9" />
            <Setter Property="Foreground" Value="#ACE2F1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Height" Value="6" />
        </Style>

        <!-- ================================================= -->
        <!-- 滚动条：收窄一点，别把卡片挤出去                    -->
        <!-- ================================================= -->

        <Style Selector="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- ================================================= -->
        <!-- 小标题                                            -->
        <!-- ================================================= -->

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#98A4AE" />
            <Setter Property="Margin" Value="6,6,6,6" />
        </Style>

        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#81909A" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

    </Application.Styles>

</Application>
